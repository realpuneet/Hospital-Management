# ---------- Core ----------
NODE_ENV=development
PORT=5000
APP_NAME=CarePulse
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TZ=Asia/Kolkata
LOG_LEVEL=debug
START_WORKER=true

# ---------- Data ----------
MONGO_URI=mongodb://127.0.0.1:27017/carepulse?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
OTP_DEV_MODE=true
OTP_TTL_SECONDS=300

# ---------- Booking rules ----------
SLOT_HOLD_MINUTES=10
BOOKING_WINDOW_DAYS=30
MIN_LEAD_MINUTES=30
FREE_CANCEL_HOURS=4
MAX_RESCHEDULES=2
PAYMENT_REQUIRED=true
MEET_BASE_URL=https://meet.jit.si

# ---------- Pharmacy ----------
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=500
GST_PERCENT=12

# ---------- Razorpay (leave blank => dry-run payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- ImageKit (leave blank => uploads disabled) ----------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------- Email (leave SMTP_HOST blank => dry-run: logs only) ----------
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="CarePulse <no-reply@carepulse.example>"

# ---------- WhatsApp (provider: dryrun | meta | twilio) ----------
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=dryrun
# Meta WhatsApp Cloud API
WA_META_TOKEN=
WA_META_PHONE_ID=
WA_META_TEMPLATE_LANG=en
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
DEFAULT_COUNTRY_CODE=91

# ---------- Admin seed ----------
SEED_ADMIN_EMAIL=admin@carepulse.local
SEED_ADMIN_PASSWORD=Admin@12345
